/**app.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f8f8f8;
  color: #333333;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
scroll-view,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  background: transparent;
  border-radius: 0;
}

button::after {
  border: 0;
}

.hm-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 180rpx;
  background: #f8f8f8;
}

.page-scroll {
  flex: 1;
  width: 100%;
  overflow: hidden;
  background: #f8f8f8;
}

.hm-page-title {
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #333333;
}

.hm-page-subtitle {
  margin-top: 10rpx;
  color: #888888;
  font-size: 26rpx;
  line-height: 1.5;
}

.hm-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(32, 18, 22, 0.06);
}

.hm-primary-button {
  height: 84rpx;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ff7f9f;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.hm-secondary-button {
  height: 76rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #fff0f4;
  color: #ff5f86;
  font-size: 26rpx;
  font-weight: 600;
}

.button-hover {
  opacity: 0.82;
}

.empty-state {
  min-height: 520rpx;
  padding: 72rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-mark {
  width: 136rpx;
  height: 136rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background: #fff0f4;
  color: #ff7f9f;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-title {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
}

.empty-desc {
  margin-top: 12rpx;
  color: #888888;
  font-size: 26rpx;
  line-height: 1.5;
}

.empty-action {
  margin-top: 34rpx;
  min-width: 220rpx;
}
