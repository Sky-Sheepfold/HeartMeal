<navigation-bar title="情侣餐桌" back="{{false}}" color="#333333" background="#f8f8f8"></navigation-bar>

<scroll-view class="page-scroll" scroll-y type="list">
  <view class="hm-page index-page">
    <view class="menu-head">
      <view class="menu-copy">
        <view class="menu-kicker">HeartMeal</view>
        <view class="hm-page-title">今天想和 TA 吃点什么？</view>
        <view class="hm-page-subtitle">先挑几道喜欢的，再慢慢决定谁请客。</view>
      </view>
      <view class="taste-entry">2人</view>
    </view>

    <view class="menu-brief hm-card">
      <view class="brief-block">
        <view class="brief-label">默认</view>
        <view class="brief-value">2 人餐桌</view>
      </view>
      <view class="brief-line"></view>
      <view class="brief-block">
        <view class="brief-label">今日</view>
        <view class="brief-value">情侣推荐</view>
      </view>
    </view>

    <scroll-view class="category-tabs" scroll-x enable-flex>
      <block wx:for="{{categories}}" wx:key="*this">
        <view
          class="category-tab {{activeCategory === item ? 'is-active' : ''}}"
          data-category="{{item}}"
          bindtap="switchCategory"
        >
          {{item}}
        </view>
      </block>
    </scroll-view>

    <view class="dish-list">
      <block wx:for="{{dishList}}" wx:key="id" wx:for-item="dish">
        <view class="dish-card hm-card {{dish.stock ? '' : 'is-soldout'}}">
          <view class="dish-cover {{dish.tone}}">
            <text>{{dish.cover}}</text>
          </view>
          <view class="dish-info">
            <view class="dish-head">
              <text class="dish-name">{{dish.name}}</text>
              <text class="dish-spicy">{{dish.spicy}}</text>
            </view>
            <view class="dish-desc">{{dish.desc}}</view>
            <view class="dish-tags">
              <block wx:for="{{dish.tags}}" wx:key="*this" wx:for-item="tag">
                <text class="dish-tag">{{tag}}</text>
              </block>
            </view>
            <view class="dish-bottom">
              <view class="dish-price">¥{{dish.price}}</view>
              <view wx:if="{{dish.count > 0}}" class="dish-stepper">
                <button
                  class="stepper-button"
                  data-id="{{dish.id}}"
                  bindtap="decreaseFromMenu"
                  hover-class="button-hover"
                >
                  −
                </button>
                <text class="stepper-value">{{dish.count}}</text>
                <button
                  class="stepper-button is-plus"
                  data-id="{{dish.id}}"
                  bindtap="addToCart"
                  hover-class="button-hover"
                >
                  +
                </button>
              </view>
              <view wx:else class="dish-actions">
                <button
                  class="add-button"
                  data-id="{{dish.id}}"
                  bindtap="addToCart"
                  disabled="{{!dish.stock}}"
                  hover-class="button-hover"
                >
                  {{dish.stock ? '+' : '售罄'}}
                </button>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>
</scroll-view>

<view class="cart-bar {{totalCount > 0 ? 'is-ready' : 'is-empty'}}">
  <view class="cart-summary" bindtap="goCart">
    <view class="cart-mark">{{totalCount > 0 ? totalCount : '餐桌'}}</view>
    <view class="cart-copy">
      <view class="cart-title">{{cartText}}</view>
      <view class="cart-desc">{{cartDesc}}</view>
    </view>
  </view>
  <button
    class="cart-action {{totalCount > 0 ? '' : 'is-disabled'}}"
    bindtap="goCheckout"
    hover-class="button-hover"
  >
    {{totalCount > 0 ? '去结算' : '先点餐'}}
  </button>
</view>
