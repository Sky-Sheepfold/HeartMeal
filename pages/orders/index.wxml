<navigation-bar title="一起吃过" color="#333333" background="#ffffff"></navigation-bar>

<scroll-view class="page-scroll" scroll-y type="list">
  <view class="hm-page orders-page">
    <view class="orders-header">
      <view>
        <view class="hm-page-title">一起吃过</view>
        <view class="hm-page-subtitle">记录你们的每一顿美味</view>
      </view>
      <button
        wx:if="{{!isEmpty}}"
        class="clear-button"
        bindtap="clearOrders"
        hover-class="button-hover"
      >
        清空
      </button>
    </view>

    <block wx:if="{{isEmpty}}">
      <view class="empty-state hm-card">
        <view class="empty-mark">记录</view>
        <view class="empty-title">还没有一起吃过的记录哦</view>
        <view class="empty-desc">去点第一餐，给今天留一条好吃的回忆</view>
        <button class="hm-primary-button empty-action" bindtap="goMenu" hover-class="button-hover">去点第一餐</button>
      </view>
    </block>

    <block wx:else>
      <view class="order-list">
        <block wx:for="{{orders}}" wx:key="orderId" wx:for-item="order">
          <view class="order-card hm-card">
            <view class="order-top">
              <view>
                <view class="order-time">{{order.createTime}}</view>
                <view class="order-id">订单 {{order.orderId}}</view>
              </view>
              <view class="order-status">{{order.status}}</view>
            </view>

            <view class="order-items">
              <block wx:for="{{order.items}}" wx:key="dishId" wx:for-item="dish">
                <view class="order-item">
                  <text>{{dish.name}} x{{dish.count}}</text>
                  <text>¥{{dish.lineTotal}}</text>
                </view>
              </block>
            </view>

            <view wx:if="{{order.remark}}" class="order-remark">备注：{{order.remark}}</view>

            <view class="order-bottom">
              <view>
                <view class="payer">{{order.payer}} · {{order.peopleCount}} 人</view>
                <view class="order-total">¥{{order.totalPrice}}</view>
              </view>
              <button
                class="hm-secondary-button reorder-button"
                data-id="{{order.orderId}}"
                bindtap="reorder"
                hover-class="button-hover"
              >
                再来一单
              </button>
            </view>
          </view>
        </block>
      </view>
    </block>
  </view>
</scroll-view>
